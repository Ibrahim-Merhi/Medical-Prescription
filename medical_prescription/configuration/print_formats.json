    "html": "<style>\n@page {\n\n    size: A4 portrait;\n\n    margin: 5mm;\n\n}\n\n.print-format {\n\n    padding: 0 !important;\n\n    margin: 0 auto !important;\n\n    width: 190mm !important;\n\n    max-width: 190mm !important;\n\n    overflow: visible !important;\n\n}\n\nhtml, body {\n\n    width: 190mm !important;\n\n    margin: 0 auto !important;\n\n    padding: 0 !important;\n\n    overflow: visible !important;\n\n}\n\n.mp-main {\n\n    width: 190mm !important;\n\n    max-width: 190mm !important;\n\n    margin: 0 auto !important;\n\n    box-sizing: border-box;\n\n}\n\n.mp-page {\n\n    width: 190mm !important;\n\n height: auto !important;\n\n    min-height: 0 !important;\n    border: 2px solid #000;\n\n    box-sizing: border-box;\n\n    overflow: visible !important;\n\n    page-break-after: always;\n\n}\n.mp-page:last-child {\n    page-break-after: auto;\n}\n\n.mp-page table {\n    width: 100% !important;\n    border-collapse: collapse;\n    table-layout: fixed;\n    box-sizing: border-box;\n}\n\n.mp-page td,\n.mp-page th {\n    border: 1px solid #000;\n    color: #000 !important;\n    vertical-align: middle;\n    box-sizing: border-box;\n}\n\n.mp-header td {\n    height: 30mm;\n    padding: 4px;\n}\n\n.logo-box {\n    width: 15%;\n    text-align: center;\n}\n\n.logo-box img {\n    max-height: 26mm;\n    max-width: 95%;\n}\n\n.title-box {\n    width: 35%;\n    text-align: center;\n    font-weight: 800;\n    font-size: 17px !important;\n    line-height: 1.3;\n}\n\n.patient-name-box {\n    width: 50%;\n    text-align: center;\n    font-weight: 800;\n    font-size: 16px !important;\n    line-height: 1.25;\n    padding: 6px !important;\n}\n\n.patient-info td {\n    height: 22mm;\n    padding: 3px 7px !important;\n    font-size: 12px !important;\n    line-height: 1.25;\n    vertical-align: top !important;\n    border: 2px solid #000 !important;\n}\n\n.left-info div,\n.right-info div {\n    margin-bottom: 0px;\n}\n\n.stop-note {\n    display: block;\n    font-weight: 800;\n    font-style: italic;\n    font-size: 10.5px !important;\n    line-height: 1.15;\n    margin-top: 0px;\n}\n\n.med-table {\n\n    width: 100% !important;\n\n    margin: 0 auto !important;\n\n}\n.section-title {\n    background: #d0d0d0;\n    font-weight: 800;\n    text-align: center;\n    font-size: 12px !important;\n    height: 8mm;\n    line-height: 1.15;\n}\n\n.nurse-title {\n    font-size: 13px !important;\n    line-height: 1.1 !important;\n}\n\n.med-table th {\n    background: #d0d0d0;\n    text-align: center;\n    font-weight: 800;\n    font-size: 9.5px !important;\n    height: 8mm;\n    padding: 1px !important;\n    overflow: hidden !important;\n}\n\n.med-table td {\n    text-align: center;\n    height: 9.4mm;\n    font-size: 10.5px !important;\n    padding: 2px !important;\n    line-height: 1.15;\n}\n\n.order-cell {\n    text-align: left !important;\n    padding: 2px 5px !important;\n    word-break: break-word;\n    overflow-wrap: anywhere;\n    vertical-align: middle !important;\n}\n\n.medication-name {\n    font-weight: 800;\n    font-size: 12px !important;\n    line-height: 1.2;\n}\n\n.order-comment {\n    margin-top: 2px;\n    font-size: 10px !important;\n    line-height: 1.15;\n}\n\n.comment-label {\n    font-weight: 800;\n}\n\n.t-col {\n    font-weight: 800;\n    font-size: 10px !important;\n    white-space: nowrap !important;\n}\n\n.doctor-end {\n    border-right: 3px solid #000 !important;\n}\n\n.nurse-start {\n    border-left: 3px solid #000 !important;\n}\n\n.checkbox-box {\n    font-size: 0 !important;\n    line-height: 1 !important;\n}\n\n.checked-box {\n    font-size: 25px !important;\n    font-weight: 900 !important;\n    line-height: 1 !important;\n}\n\n.signature-table {\n    width: 100% !important;\n    margin-top: 1px;\n    height: 28mm;\n    table-layout: fixed;\n    border-collapse: collapse;\n}\n\n.signature-table td {\n    border: 2px solid #000 !important;\n    box-sizing: border-box;\n}\n\n.signature-big {\n    height: 28mm;\n    vertical-align: top !important;\n    padding: 5px !important;\n    font-size: 10px !important;\n    line-height: 1.3;\n}\n\n.signature-vertical {\n    height: 28mm !important;\n    padding: 1px !important;\n    text-align: center !important;\n    vertical-align: middle !important;\n    background: #d0d0d0;\n    font-weight: 800;\n    font-size: 9px !important;\n    line-height: 1;\n}\n\n.signature-vertical span {\n    display: inline-block;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    white-space: nowrap;\n}\n\n.initials-cell {\n    height: 14mm !important;\n    padding: 1px !important;\n    text-align: center !important;\n    vertical-align: middle !important;\n    font-size: 9px !important;\n    font-weight: 800 !important;\n    line-height: 1;\n}\n\n.initials-cell span {\n    display: inline-block;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    white-space: nowrap;\n}\n\n.stamp-box {\n    height: 14mm !important;\n    padding: 2px !important;\n    text-align: center !important;\n    vertical-align: middle !important;\n}\n\n.initials-column {\n    height: 28mm !important;\n    padding: 1px !important;\n    text-align: center !important;\n    vertical-align: middle !important;\n    font-weight: 800;\n    font-size: 9px !important;\n    line-height: 1;\n}\n\n.initials-column span {\n    display: inline-block;\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    white-space: nowrap;\n}\n\n.order-cell-centered {\n    vertical-align: middle !important;\n}\n\n.order-cell-centered .medication-name {\n    display: flex;\n    align-items: center;\n    min-height: 100%;\n}\n\n</style>\n\n{% set meds =\n    doc.medication_orders\n    or doc.medication_order\n    or doc.doctor_medication_orders\n    or doc.items\n    or []\n%}\n\n{% set hours = [10,12,14,16,18,20,22,24,2,4,6,8,10] %}\n\n{# Exactly 18 medication rows on each page #}\n{% set rows_per_page = 18 %}\n{% set page1_meds = meds[:rows_per_page] %}\n{% set page2_meds = meds[rows_per_page:rows_per_page * 2] %}\n\n{#\n    Find the first Medical Prescription for the same admission.\n\n    First prescription:\n    Display its real creation time.\n\n    Later/duplicated prescriptions:\n    Display 08:30.\n#}\n{% set first_prescriptions = frappe.get_all(\n    \"Medical Prescription\",\n    filters={\n        \"inpatient_record\": doc.inpatient_record\n    },\n    fields=[\n        \"name\",\n        \"creation\"\n    ],\n    order_by=\"creation asc\",\n    limit_page_length=1\n) %}\n\n{% set is_first_prescription =\n    first_prescriptions\n    and first_prescriptions[0].name == doc.name\n%}\n\n{#\n    Do not convert the timezone again.\n    ERPNext is already returning the time needed by this print format.\n#}\n{% if first_prescriptions and first_prescriptions[0].creation %}\n    {% set first_creation_text = first_prescriptions[0].creation|string %}\n    {% set first_creation_time = first_creation_text[11:16] %}\n{% else %}\n    {% set first_creation_time = \"08:30\" %}\n{% endif %}\n\n{% macro medication_table(page_meds, page_no) %}\n<table class=\"med-table\">\n    <colgroup>\n        <col style=\"width:6%\">\n        <col style=\"width:36%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4.2%\">\n\n        {% for h in hours %}\n            <col style=\"width:4.2%\">\n        {% endfor %}\n    </colgroup>\n\n    <tr>\n        <td colspan=\"5\" class=\"section-title doctor-end\">\n            DOCTOR PRESCRIPTION\n        </td>\n\n        <td\n            colspan=\"{{ hours | length + 1 }}\"\n            class=\"section-title nurse-start nurse-title\"\n        >\n            NURSE PRESCRIPTIONS DISTRIBUTION\n        </td>\n    </tr>\n\n    <tr>\n        <th>T</th>\n        <th>Medication / Dose / Freq. / Route / Timing</th>\n        <th>PRN</th>\n        <th>Hold</th>\n        <th class=\"doctor-end\">Stop</th>\n        <th class=\"nurse-start\"></th>\n\n        {% for h in hours %}\n            <th>{{ h }}</th>\n        {% endfor %}\n    </tr>\n\n    {% for row in page_meds %}\n        {% set dose = row.dose_number or \"\" %}\n        {% set dose_text = dose|string %}\n\n        {% if dose_text.endswith(\".0\") %}\n            {% set dose_text = dose_text[:-2] %}\n        {% endif %}\n\n        <tr>\n            <td class=\"t-col\">\n                {% if page_no == 1 and loop.first %}\n                    {% if is_first_prescription %}\n                        {{ first_creation_time }}\n                    {% else %}\n                        08:30\n                    {% endif %}\n                {% endif %}\n            </td>\n\n<td class=\"order-cell {% if not row.comment %}order-cell-centered{% endif %}\">\n<div class=\"medication-name {% if not row.comment %}medication-name-no-comment{% endif %}\">\n        {{ row.medication or row.drug_name or row.drug or row.item_name or row.item_code or \"\" }}\n        {% if dose_text %} {{ dose_text }}{{ row.dose_uom or row.unit or \"\" }}{% endif %}\n        {% if row.route or row.route_of_administration %} {{ row.route or row.route_of_administration }}{% endif %}\n        {% if row.frequency or row.freq %} {{ row.frequency or row.freq }}{% endif %}\n        {% if row.custom_time or row.time or row.medication_time %} {{ row.custom_time or row.time or row.medication_time }}{% endif %}\n    </div>\n\n    {% if row.comment %}\n        <div class=\"order-comment\">\n            <span class=\"comment-label\">Comment:</span> {{ row.comment }}\n        </div>\n    {% endif %}\n</td>\n\n            <td class=\"checkbox-box\">\n                {% if row.prn == 1 or row.prn == \"1\" or row.prn == true or row.prn == \"Yes\" or row.prn == \"yes\" %}\n                    <span class=\"checked-box\">■</span>\n                {% endif %}\n            </td>\n\n            <td class=\"checkbox-box\">\n                {% if row.hold == 1 or row.hold == \"1\" or row.hold == true or row.hold == \"Yes\" or row.hold == \"yes\" %}\n                    <span class=\"checked-box\">■</span>\n                {% endif %}\n            </td>\n\n            <td class=\"checkbox-box doctor-end\">\n                {% if row.stop == 1 or row.stop == \"1\" or row.stop == true or row.stop == \"Yes\" or row.stop == \"yes\" %}\n                    <span class=\"checked-box\">■</span>\n                {% endif %}\n            </td>\n\n            <td class=\"nurse-start\"></td>\n            {% for h in hours %}\n                <td></td>\n            {% endfor %}\n        </tr>\n    {% endfor %}\n\n        {% set used_rows = page_meds | length %}\n        {% set empty_rows = rows_per_page - used_rows %}\n\n    {% if empty_rows > 0 %}\n        {% for i in range(empty_rows) %}\n            <tr>\n                <td></td>\n                <td></td>\n                <td class=\"checkbox-box\"></td>\n                <td class=\"checkbox-box\"></td>\n                <td class=\"doctor-end checkbox-box\"></td>\n                <td class=\"nurse-start\"></td>\n                {% for h in hours %}\n                    <td></td>\n                {% endfor %}\n            </tr>\n        {% endfor %}\n    {% endif %}\n</table>\n{% endmacro %}\n\n{% macro signature_table() %}\n<table class=\"signature-table\">\n    <colgroup>\n<col style=\"width:23%\">\n<col style=\"width:24%\">\n<col style=\"width:6%\">\n<col style=\"width:5%\">\n<col style=\"width:18%\">\n<col style=\"width:5%\">\n<col style=\"width:19%\">\n    </colgroup>\n\n    <tr>\n        <td rowspan=\"2\" class=\"signature-big\">\n            <b>Practitioner Signature:</b>\n            <br><br>\n            Digitally signed by<br>\n            {{ frappe.get_fullname(frappe.session.user) }}\n        </td>\n\n        <td rowspan=\"2\" class=\"signature-big\">\n            <b>Valid:</b>\n            &nbsp;&nbsp;\n            ☐ Yes\n            &nbsp;&nbsp;&nbsp;\n            ☐ No\n            <br><br>\n            <b>Pharmacist Signature &amp; Notes:</b>\n        </td>\n\n        <td rowspan=\"2\" class=\"signature-vertical\">\n            <span>Initial / Signature ID</span>\n        </td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">&nbsp;</td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">&nbsp;</td>\n    </tr>\n\n    <tr>\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">&nbsp;</td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">&nbsp;</td>\n    </tr>\n</table>\n{% endmacro %}\n\n{% macro page_header() %}\n<table class=\"mp-header\">\n    <tr>\n        <td class=\"logo-box\">\n            {% set logo = frappe.db.get_single_value(\"Medical Prescription Settings\", \"organization_logo\") %}{% if logo %}<img src=\"{{ logo | e }}\">{% endif %}\n        </td>\n        <td class=\"title-box\">\n            {{ frappe.db.get_single_value(\"Medical Prescription Settings\", \"organization_name\") or \"\" }}<br>\n            MEDICAL PRESCRIPTION\n        </td>\n        <td class=\"patient-name-box\">\n            {{ doc.patient_name or doc.patient or \"\" }}\n        </td>\n    </tr>\n</table>\n\n<table class=\"patient-info\">\n    <colgroup>\n        <col style=\"width:39%\">\n        <col style=\"width:61%\">\n    </colgroup>\n    <tr>\n    <td class=\"left-info\">\n        <div><b>Date</b> : {{ doc.prescription_date or \"\" }}</div>\n        <div><b>Service</b> : {{ doc.service_unit or doc.custom_service_unit or \"\" }}</div>\n        <div><b>Bed</b> : {{ doc.bed_nb or \"\" }}</div>\n\n        <div>\n            <b>Day No.</b> : {{ doc.stay_duration_days or \"\" }}\n            &nbsp;&nbsp;&nbsp;\n            <b>Prescription No.</b> : 1\n        </div>\n    </td>\n\n    <td class=\"right-info\">\n        <div>\n    {% if doc.medical_diagnosis %}\n        <b>Medical Diagnosis:</b> {{ doc.medical_diagnosis }}\n\n    {% elif doc.chief_complaint %}\n        <b>Chief Complaint:</b> {{ doc.chief_complaint }}\n\n    {% else %}\n        <b>Medical Diagnosis:</b>\n    {% endif %}\n</div>\n\n        <div>\n            <b>Weight:</b>\n            {% if doc.weight %}\n                {{ doc.weight }} kg\n            {% endif %}\n\n            &nbsp;&nbsp;&nbsp;\n\n            <b>Height:</b>\n            {% if doc.height %}\n                {{ doc.height }} cm\n            {% endif %}\n\n            &nbsp;&nbsp;&nbsp;\n\n            <b>Allergy:</b>\n            {{ doc.allergies or doc.allergy or \"\" }}\n        </div>\n\n        <div>\n            {% if doc.pregnancy %}☑{% else %}☐{% endif %} Pregnancy\n            &nbsp;&nbsp;\n\n            {% if doc.breastfeeding %}☑{% else %}☐{% endif %} Breastfeeding\n            &nbsp;&nbsp;\n\n            <b>DFG estimated (MDRD):</b>\n        </div>\n\n        <div class=\"stop-note\">\n            AUTOMATIC STOP ORDERS if not specified by practitioner:\n            Heparin (7 days), Steroids (7 days), Narcotics (3 days),\n            Antibiotics (7 days), IV fluids (24 hours)\n        </div>\n    </td>\n</tr>\n</table>\n{% endmacro %}\n\n<div class=\"mp-main\">\n\n    <div class=\"mp-page\">\n        {{ page_header() }}\n        {{ medication_table(page1_meds, 1) }}\n        {{ signature_table() }}\n    </div>\n\n    <div class=\"mp-page\">\n        {{ page_header() }}\n        {{ medication_table(page2_meds, 2) }}\n        {{ signature_table() }}\n    </div>\n\n</div>",
