    "html": "<style>\n@page {\n    size: A4 portrait;\n    margin: 5mm;\n}\n\n.print-format {\n    padding: 0 !important;\n    margin: 0 auto !important;\n    width: 190mm !important;\n    max-width: 190mm !important;\n    overflow: visible !important;\n}\n\nhtml, body {\n    width: 190mm !important;\n    margin: 0 auto !important;\n    padding: 0 !important;\n    overflow: visible !important;\n}\n\n.mp-main {\n    width: 190mm !important;\n    max-width: 190mm !important;\n    margin: 0 auto !important;\n    box-sizing: border-box;\n}\n\n.mp-page {\n    width: 190mm !important;\n    height: auto !important;\n    min-height: 0 !important;\n    border: 2px solid #000;\n    box-sizing: border-box;\n    overflow: visible !important;\n    page-break-after: auto;\n}\n\n.mp-page table {\n    width: 100% !important;\n    border-collapse: collapse;\n    table-layout: fixed;\n    box-sizing: border-box;\n}\n\n.mp-page td,\n.mp-page th {\n    border: 1px solid #000;\n    color: #000 !important;\n    vertical-align: middle;\n    box-sizing: border-box;\n}\n\n.mp-header td {\n    height: 30mm;\n    padding: 4px;\n}\n\n.logo-box {\n    width: 15%;\n    text-align: center;\n}\n\n.logo-box img {\n    max-height: 26mm;\n    max-width: 95%;\n}\n\n.title-box {\n    width: 35%;\n    text-align: center;\n    font-weight: 800;\n    font-size: 17px !important;\n    line-height: 1.3;\n}\n\n.patient-name-box {\n    width: 50%;\n    text-align: center;\n    font-weight: 800;\n    font-size: 16px !important;\n    line-height: 1.25;\n    padding: 6px !important;\n}\n\n.patient-info td {\n    height: 22mm;\n    padding: 3px 7px !important;\n    font-size: 12px !important;\n    line-height: 1.25;\n    vertical-align: top !important;\n    border: 2px solid #000 !important;\n}\n\n.left-info div,\n.right-info div {\n    margin-bottom: 0px;\n}\n\n.stop-note {\n    display: block;\n    font-weight: 800;\n    font-style: italic;\n    font-size: 10.5px !important;\n    line-height: 1.15;\n    margin-top: 0px;\n}\n\n.med-table {\n    width: 100% !important;\n    margin: 0 auto !important;\n}\n\n.section-title {\n    background: #d0d0d0;\n    font-weight: 800;\n    text-align: center;\n    font-size: 12px !important;\n    height: 8mm;\n    line-height: 1.15;\n}\n\n.nurse-title {\n    font-size: 13px !important;\n    line-height: 1.1 !important;\n}\n\n.med-table th {\n    background: #d0d0d0;\n    text-align: center;\n    font-weight: 800;\n    font-size: 9.5px !important;\n    height: 8mm;\n    padding: 1px !important;\n    overflow: hidden !important;\n}\n\n.med-table td {\n    text-align: center;\n    height: 9.4mm;\n    font-size: 10.5px !important;\n    padding: 2px !important;\n    line-height: 1.15;\n}\n\n.order-cell {\n    text-align: left !important;\n    padding: 2px 5px !important;\n}\n\n.doctor-end {\n    border-right: 3px solid #000 !important;\n}\n\n.nurse-start {\n    border-left: 3px solid #000 !important;\n}\n\n.checkbox-box {\n    font-size: 0 !important;\n    line-height: 1 !important;\n}\n\n.signature-table {\n    margin-top: 1px;\n    height: 22mm;\n}\n\n.signature-table td {\n    border: 2px solid #000 !important;\n}\n\n.signature-big {\n    height: 22mm;\n    vertical-align: top !important;\n    padding: 5px !important;\n    font-size: 10px !important;\n    line-height: 1.3;\n}\n\n.signature-small {\n    height: 11mm;\n}\n\n.signature-vertical {\n    writing-mode: vertical-rl;\n    transform: rotate(180deg);\n    text-align: center !important;\n    font-weight: 800;\n    font-size: 9px !important;\n    background: #d0d0d0;\n    padding: 2px !important;\n}\n</style>\n\n{% set hours = [10,12,14,16,18,20,22,24,2,4,6,8,10] %}\n{% set rows_per_page = 18 %}\n\n\n{% macro empty_medication_table() %}\n<table class=\"med-table\">\n    <colgroup>\n        <col style=\"width:6%\">\n        <col style=\"width:36%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4%\">\n        <col style=\"width:4.2%\">\n\n        {% for h in hours %}\n            <col style=\"width:4.2%\">\n        {% endfor %}\n    </colgroup>\n\n    <tr>\n        <td\n            colspan=\"5\"\n            class=\"section-title doctor-end\"\n        >\n            DOCTOR PRESCRIPTION\n        </td>\n\n        <td\n            colspan=\"{{ hours | length + 1 }}\"\n            class=\"section-title nurse-start nurse-title\"\n        >\n            NURSE PRESCRIPTIONS DISTRIBUTION\n        </td>\n    </tr>\n\n    <tr>\n        <th>T</th>\n\n        <th>\n            Medication / Dose / Freq. / Route / Timing\n        </th>\n\n        <th>PRN</th>\n        <th>Hold</th>\n\n        <th class=\"doctor-end\">\n            Stop\n        </th>\n\n        <th class=\"nurse-start\"></th>\n\n        {% for h in hours %}\n            <th>{{ h }}</th>\n        {% endfor %}\n    </tr>\n\n    {% for i in range(rows_per_page) %}\n        <tr>\n            <td class=\"t-col\"></td>\n\n            <td class=\"order-cell\"></td>\n\n            <td class=\"checkbox-box\"></td>\n\n            <td class=\"checkbox-box\"></td>\n\n            <td class=\"doctor-end checkbox-box\"></td>\n\n            <td class=\"nurse-start\"></td>\n\n            {% for h in hours %}\n                <td></td>\n            {% endfor %}\n        </tr>\n    {% endfor %}\n</table>\n{% endmacro %}\n\n\n{% macro signature_table() %}\n<table class=\"signature-table\">\n    <colgroup>\n        <col style=\"width:23%\">\n        <col style=\"width:24%\">\n        <col style=\"width:6%\">\n        <col style=\"width:5%\">\n        <col style=\"width:18%\">\n        <col style=\"width:5%\">\n        <col style=\"width:19%\">\n    </colgroup>\n\n    <tr>\n        <td\n            rowspan=\"2\"\n            class=\"signature-big\"\n        >\n            <b>Practitioner Signature:</b>\n\n            <br><br>\n\n            Digitally signed by<br>\n            {{ frappe.get_fullname(frappe.session.user) }}\n        </td>\n\n        <td\n            rowspan=\"2\"\n            class=\"signature-big\"\n        >\n            <b>Valid:</b>\n\n            &nbsp;&nbsp;\n\n            ☐ Yes\n\n            &nbsp;&nbsp;&nbsp;\n\n            ☐ No\n\n            <br><br>\n\n            <b>Pharmacist Signature &amp; Notes:</b>\n        </td>\n\n        <td\n            rowspan=\"2\"\n            class=\"signature-vertical\"\n        >\n            <span>Initial / Signature ID</span>\n        </td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">\n            &nbsp;\n        </td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">\n            &nbsp;\n        </td>\n    </tr>\n\n    <tr>\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">\n            &nbsp;\n        </td>\n\n        <td class=\"initials-cell\">\n            <span></span>\n        </td>\n\n        <td class=\"stamp-box\">\n            &nbsp;\n        </td>\n    </tr>\n</table>\n{% endmacro %}\n\n\n{% macro page_header() %}\n<table class=\"mp-header\">\n    <tr>\n        <td class=\"logo-box\">\n            {% set logo = frappe.db.get_single_value(\"Medical Prescription Settings\", \"organization_logo\") %}{% if logo %}<img src=\"{{ logo | e }}\">{% endif %}\n        </td>\n\n        <td class=\"title-box\">\n            {{ frappe.db.get_single_value(\"Medical Prescription Settings\", \"organization_name\") or \"\" }}<br>\n            MEDICAL PRESCRIPTION\n        </td>\n\n        <td class=\"patient-name-box\">\n            {{ doc.patient_name or doc.patient or \"\" }}\n        </td>\n    </tr>\n</table>\n\n\n<table class=\"patient-info\">\n    <colgroup>\n        <col style=\"width:39%\">\n        <col style=\"width:61%\">\n    </colgroup>\n\n    <tr>\n        <td class=\"left-info\">\n            <div>\n                <b>Date</b> :\n                {{ doc.prescription_date or \"\" }}\n            </div>\n\n            <div>\n                <b>Service</b> :\n                {{ doc.service_unit or doc.custom_service_unit or \"\" }}\n            </div>\n\n            <div>\n                <b>Bed</b> :\n                {{ doc.bed_nb or \"\" }}\n            </div>\n\n            <div>\n                <b>Day No.</b> :\n                {{ doc.stay_duration_days or \"\" }}\n\n                &nbsp;&nbsp;&nbsp;\n\n                <b>Prescription No.</b> :\n                1\n            </div>\n        </td>\n\n        <td class=\"right-info\">\n            <div>\n                {% if doc.medical_diagnosis %}\n                    <b>Medical Diagnosis:</b>\n                    {{ doc.medical_diagnosis }}\n\n                {% elif doc.chief_complaint %}\n                    <b>Chief Complaint:</b>\n                    {{ doc.chief_complaint }}\n\n                {% else %}\n                    <b>Medical Diagnosis:</b>\n                {% endif %}\n            </div>\n\n            <div>\n                <b>Weight:</b>\n\n                {% if doc.weight %}\n                    {{ doc.weight }} kg\n                {% endif %}\n\n                &nbsp;&nbsp;&nbsp;\n\n                <b>Height:</b>\n\n                {% if doc.height %}\n                    {{ doc.height }} cm\n                {% endif %}\n\n                &nbsp;&nbsp;&nbsp;\n\n                <b>Allergy:</b>\n                {{ doc.allergies or doc.allergy or \"\" }}\n            </div>\n\n            <div>\n                {% if doc.pregnancy %}\n                    ☑\n                {% else %}\n                    ☐\n                {% endif %}\n                Pregnancy\n\n                &nbsp;&nbsp;\n\n                {% if doc.breastfeeding %}\n                    ☑\n                {% else %}\n                    ☐\n                {% endif %}\n                Breastfeeding\n\n                &nbsp;&nbsp;\n\n                <b>DFG estimated (MDRD):</b>\n            </div>\n\n            <div class=\"stop-note\">\n                AUTOMATIC STOP ORDERS if not specified by practitioner:\n                Heparin (7 days), Steroids (7 days), Narcotics (3 days),\n                Antibiotics (7 days), IV fluids (24 hours)\n            </div>\n        </td>\n    </tr>\n</table>\n{% endmacro %}\n\n\n<div class=\"mp-main\">\n\n    <div class=\"mp-page\">\n        {{ page_header() }}\n        {{ empty_medication_table() }}\n        {{ signature_table() }}\n    </div>\n</div>",
